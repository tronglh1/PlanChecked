<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6-11 full-backup rules (allowBackup is false anyway; kept as defence in depth). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
